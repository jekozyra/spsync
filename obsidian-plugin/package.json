{
  "name": "obsidian-spsync",
  "version": "0.1.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.ts",
    "diagrams": "node diagrams.ts",
    "diagrams:check": "node diagrams.ts --check",
    "format": "oxfmt --ignore-path ../.gitignore --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --ignore-path ../.gitignore --ignore-path .oxfmtignore --check .",
    "lint": "oxlint .",
    "test": "node --test \"*.test.ts\""
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "pele": "^1.13.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=23.6"
  }
}
