{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": [
    "main.ts",
    "standalone-cli.ts",
    "standalone-cli.test.ts",
    "esbuild.ts",
    "diagrams.ts",
    "oxlint.config.ts"
  ]
}
